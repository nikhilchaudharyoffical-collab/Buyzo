
{
  "installCommand": "pnpm install",
  "buildCommand": "cd dropcart-store && pnpm run build",
  "outputDirectory": "dropcart-store/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://buydo.onrender.com/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
