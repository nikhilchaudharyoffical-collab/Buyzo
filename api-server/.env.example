# Required
PORT=8080
DATABASE_URL=postgres://user:password@host:5432/dbname

# Admin dashboard login (visit /admin on the frontend)
ADMIN_USERNAME=changeme
ADMIN_PASSWORD=changeme
SESSION_SECRET=any-long-random-string

# Optional — only needed if you use Clerk auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional
LOG_LEVEL=info
NODE_ENV=production
